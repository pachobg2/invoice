<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- run on the 4.x runtime when it is installed (Windows 8 and later), otherwise on the 2.0/3.5 runtime that Windows XP / Vista / 7 have -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0.30319"/>
    <supportedRuntime version="v2.0.50727"/>
  </startup>
</configuration>
